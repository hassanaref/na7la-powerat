# Powerk Backend Configuration
DEVICE_PORT=10086
WEB_PORT=8080
HOST=0.0.0.0
LOCAL_IP=

# Security Token (optional for web API, empty = open on LAN)
API_TOKEN=

# Database (SQLite default, can be PostgreSQL e.g. postgresql+asyncpg://user:pass@localhost/powerk)
DATABASE_URL=sqlite+aiosqlite:///powerk.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ENABLED=true

# Polling & Diagnostics
POLL_INTERVAL=5.0
DIAGNOSTICS_INTERVAL=15.0
TELEMETRY_LOG_INTERVAL=60.0

# Egyptian Electricity Tariff (Average estimate in EGP per kWh)
ELECTRICITY_COST_PER_KWH=1.85
